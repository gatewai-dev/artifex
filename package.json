{
	"name": "artifex-monorepo",
	"private": true,
	"version": "1.0.0",
	"description": "Artifex CLI, Gatewai Node SDK, WebGPU Renderers, and Reference Nodes Monorepo",
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"clean": "pnpm -r exec rm -rf dist .turbo",
		"format": "biome check --write",
		"cli": "node apps/gatewai-artifex/dist/index.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@types/node": "^24.1.0",
		"turbo": "^2.5.4",
		"typescript": "^5.8.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"esbuild",
			"node-av",
			"sharp",
			"skia-canvas",
			"webgpu"
		]
	},
	"engines": {
		"node": ">=22"
	}
}
