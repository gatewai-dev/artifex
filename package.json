{
	"name": "@gatewai.studio/artifex",
	"private": false,
	"version": "1.0.139",
	"type": "module",
	"description": "Artifex CLI tool for Gatewai workflow automation and node processing",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gatewai-dev/Gatewai.git",
		"directory": "apps/gatewai-artifex"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"artifex": "./dist/index.mjs",
		"gatewai-artifex": "./dist/index.mjs",
		"gatewai": "./dist/index.mjs"
	},
	"files": [
		"dist",
		"assets"
	],
	"scripts": {
		"clean": "rm -rf ./dist",
		"build": "pnpm run clean && node scripts/generate-nodes-registry.mjs && tsdown && node scripts/generate-main-skill.mjs",
		"generate:skill": "node scripts/generate-main-skill.mjs",
		"typecheck": "tsc -b tsconfig.json",
		"cli": "node dist/index.mjs",
		"prepublishOnly": "pnpm run build",
		"test": "vitest run"
	},
	"dependencies": {
