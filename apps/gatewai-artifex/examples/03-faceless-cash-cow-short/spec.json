  "nodes": [
    {
      "id": "prompt-script",
      "type": "Text",
      "name": "Story Hook Prompt",
      "config": {
        "content": "Write a 5-sentence humorous, high-retention viral short script about the 1932 Great Emu War where Australia lost a military war against 20,000 birds. Sentence 1: In 1932, Australia declared official war on 20,000 giant birds. Sentence 2: Soldiers armed with heavy Lewis machine guns were sent to crush them. Sentence 3: The emus used guerrilla warfare and dodged bullets with tactical brilliance. Sentence 4: The guns jammed, trucks crashed, and the army surrendered in complete defeat. Sentence 5: Emus suffered zero casualties and won the war. Return ONLY the 5 narration sentences."
      }
    },
    {
      "id": "llm-writer",
      "type": "LLM",
      "name": "Hook Script Generator",
      "config": {
        "model": "google/gemini-3.7-flash"
      }
    },
    {
      "id": "tts-voice",
      "type": "TextToSpeech",
      "name": "Authoritative Narrator Voice",
      "config": {
        "provider": "gemini",
        "languageCode": "auto",
        "speakerConfig": [
          {
            "speaker": "Speaker1",
            "voice": "Charon"
          }
        ],
        "temperature": 0.8,
        "outputFormat": "mp3"
      }
    },
    {
      "id": "captions",
      "type": "CaptionGenerator",
      "name": "Whisper Word-Level Subtitles",
      "config": {
        "model": "fal-ai/whisper",
        "task": "transcribe",
        "language": "en",
        "chunk_level": "segment"
      }
    },
