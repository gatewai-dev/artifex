{
	"extends": "@gatewai.studio/tsconfig/base.json",
	"compilerOptions": {
		"composite": false,
		"target": "esnext",
		"lib": ["esnext"],
		"module": "nodenext",
		"moduleDetection": "force",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["__tests__/**/*"]
}
