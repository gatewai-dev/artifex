{
	"name": "@gatewai.studio/core",
	"version": "1.1.5",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"license": "APGL-3.0",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./src/index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"dev": "tsdown --watch",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"devDependencies": {
		"@gatewai.studio/tsconfig": "workspace:*",
		"tsdown": "^0.19.0",
		"@fal-ai/client": "^1.9.4",
		"openai": "^6.29.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"nanoid": "^5.1.6",
		"zod": "^4.3.6"
	}
}
