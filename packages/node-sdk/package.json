{
	"name": "@gatewai.studio/node-sdk",
	"version": "1.1.6",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"license": "APGL-3.0",
	"description": "SDK for building Gatewai node plugins",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"development": "./index.ts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./server": {
			"types": "./dist/server.d.mts",
			"development": "./server/index.ts",
			"import": "./dist/server.mjs",
			"default": "./dist/server.mjs"
		},
		"./browser": {
			"types": "./dist/browser.d.mts",
			"development": "./browser/index.ts",
			"import": "./dist/browser.mjs",
			"default": "./dist/browser.mjs"
		},
		"./renderer": {
			"types": "./dist/renderer.d.mts",
			"development": "./renderer/index.ts",
			"import": "./dist/renderer.mjs",
			"default": "./dist/renderer.mjs"
		}
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsdown --format esm",
		"dev": "tsdown --format esm --watch",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"devDependencies": {
		"@gatewai.studio/tsconfig": "workspace:*",
		"@types/node": "^24.1.0",
		"@types/react": "^19.2.4",
		"tsdown": "^0.19.0",
		"typescript": "^5.8.3",
		"webgpu": "^0.4.0"
	},
	"peerDependencies": {
		"@gatewai.studio/core": "workspace:*",
		"inversify": "*",
		"hono": "*",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@gatewai.studio/webgpu-renderers": "workspace:*"
	}
}
